    type is a genuine declarative type (soundness), and it is principal. -/
theorem matchWild_headlines_fire :
    ∃ σ τ, typecheck [] matchWild = some σ ∧ σ = genScheme [] [] τ ∧
      TypeOfHM ⟨[], []⟩ matchWild.eraseBounds (Ty.eraseBounds τ) ∧
