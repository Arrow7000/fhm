      have h1 : S₂.onTy (Ty.closeOver (genVars rhs.tyFreeVars (S₁.onCtx ctx).env τ₁) τ₁)
          = Ty.closeOver (genVars rhs.tyFreeVars (S₁.onCtx ctx).env τ₁) (S₂.onTy τ₁) :=
