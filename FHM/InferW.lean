      obtain ⟨m, hm1, _, rfl⟩ := hmono_shape τ (hmonoTys_mem τ hτ)
      have hgrange := (InferRecGroup.eOut_avoid hgroup (w := g) (by omega)
        (by intro M hM
            rcases List.mem_append.mp hM with hM | hM
            · obtain ⟨s, hs, rfl⟩ := List.mem_map.mp hM
