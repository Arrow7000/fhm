      by_contra hlt
      push_neg at hlt
      have hg_S₁dom : ∀ p ∈ S₁, p.1 ≠ g := fun p hp hpeq => helimR.2 p hp (hpeq ▸ hgenV_τ₁ g hg)
      have hg_ctxenv : ∀ M ∈ ctx.env, g ∉ M.body.freeVars := by
