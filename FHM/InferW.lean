      obtain ⟨m, hm1, hm2, rfl⟩ := hmono_shape τ (hmonoTys_mem τ hτ)
      refine Ty.BelowFvars.of_freeVars_lt (fun v hv => ?_)
      rcases Subst.mem_freeVars_onTy hv with h | ⟨p, hp, hvp⟩
      · simp only [Ty.freeVars, List.mem_singleton] at h
