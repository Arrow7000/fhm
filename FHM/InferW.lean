      · obtain ⟨s, hs, rfl⟩ := List.mem_map.mp hs'
        cases s with
        | mono τ0 =>
          rcases RecSpec.mem_init hs with ⟨m, _, _, heq⟩ | ⟨σ0, _, heq⟩
          · cases heq
