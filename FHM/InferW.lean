    ∃ σ τ, typecheck [] polyId = some σ ∧ σ = genScheme [] [] τ ∧
      TypeOfHM ⟨[], []⟩ polyId.eraseBounds (Ty.eraseBounds τ) ∧
      ∀ τ₀, TypeOfHM ⟨[], []⟩ polyId.eraseBounds τ₀ → ∃ R : Subst, τ₀ = R.onTy τ := by
