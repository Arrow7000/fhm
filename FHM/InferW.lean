    have hbodysound := Infer.sound hbody hbodyWF hbodyBelow K
      (fun k hk => by have := hKΦ k hk; omega)
      (fun y hy => hKe y (.inr hy)) hS₂K
    -- assemble residual packing via `Expr.letRecElab_sound` at the residual ctx
