-- annotations, λ/pattern binders, use sites, lits, ops.

type Maybe a =
  | Just a
  | Nothing

type Tree a =
  | Leaf
  | Node a (left : Tree a) (right : Tree a)

type Color = Red | Green | Blue

let map : {a b} (a -> b) -> List a -> List b =
  \f xs ->
    match xs with
    | [] -> []
    | h :: t -> (f h) :: (map f t)

let filter : {a} (a -> Bool) -> List a -> List a =
  \p xs ->
    match xs with
    | [] -> []
    | h :: t ->
      if p h then
        h :: (filter p t)
      else
        filter p t

let mapMaybe : {a b} (a -> b) -> Maybe a -> Maybe b =
  \f m ->
    match m with
    | Nothing -> Nothing
    | Just x -> Just (f x)

let treeMap : {a b} (a -> b) -> Tree a -> Tree b =
  \f t ->
    match t with
    | Leaf -> Leaf
    | Node x l r -> Node (f x) (treeMap f l) (treeMap f r)

let colorOf = \n ->
  if n < 2 then
    Red
  else if n < 5 then
    Green
  else
    Blue

let warm = \c ->
  match c with
  | Red -> True
  | Green -> False
  | Blue -> False

let t = Node 1 Leaf (Node 4 Leaf (Node 9 Leaf Leaf))

let xs = [0, 1, 4, 9, 2]

let listLength = \l ->
  match l with
  | [] -> 0
  | head :: tail -> 1 + listLength tail

let addInts : Int -> Int -> Int = \a b -> a + b

addInts (listLength xs) 12
