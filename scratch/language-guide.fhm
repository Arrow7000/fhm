-- FHM language guide: scoped type variables and recursion.
--
-- Run with:
--   .lake/build/bin/fhm run scratch/language-guide.fhm
--
-- This file is both documentation and a regression fixture: every active
-- definition must typecheck, and the final expression must evaluate.
-- Programs that must be rejected are commented out at the end; paste one into
-- its own file to see the error.
--
-- Terminology: a *signature* is a complete type annotation on a `let`
-- binding, such as `let f : {a} a -> List a = ...`.
--
-- Scoped type variables
-- ---------------------
-- The type variables a signature quantifies (`{a b}`) are in scope throughout
-- that binding's body, as fixed types: annotations on lambda parameters and
-- on inner `let`s may mention them, but they cannot be specialised to a
-- concrete type. This holds for top-level definitions and for nested
-- `let ... in` alike.
--
-- Recursion
-- ---------
-- Definitions that refer to each other form a recursive group. Within one:
--
--   * A definition with a signature has a known type, so every use of it --
--     including its own recursive calls -- may use it at a different type
--     (polymorphic recursion).
--   * References to annotated definitions don't count as dependencies when
--     the rest is inferred. The unannotated definitions are split into their
--     own recursive groups, which are inferred and generalised one at a time
--     in dependency order.
--   * Annotated bodies are checked last, against the final types of
--     everything.
--   * Unannotated definitions that really do depend on each other share one
--     type each while their group is inferred (ordinary Hindley-Milner).
--
-- Signatures only affect type inference; evaluation is unchanged.
--
-- Out of scope: head-binder sugar (`let f {a} (x : a) : a = ...`) and
-- annotations on patterns (`Just (x : a)`); neither is supported syntax.

type Maybe a = Just a | Nothing

-- A nested datatype: each `Nest` level wraps the elements in another list.
type Nested a = Flat a | Nest (Nested (List a))


-- =========================================================================
-- Scoped type variables
-- =========================================================================

-- 01: top-level; the scoped `a` is used in a lambda-parameter annotation.
let idParam : {a} a -> a =
  \(x : a) -> x

-- 02: top-level; the scoped `a` is used in an inner `let` annotation.
let idLet : {a} a -> a =
  \x ->
    let y : a = x in
    y

-- 03: the motivating case. `f` closes over `x : a`, so it cannot be
-- generalised; its type is only expressible using the outer `a` and `b`.
let constHelper : {a b} a -> b -> a =
  \x y ->
    let f : b -> a = \z -> x in
    f y

-- 04: the scoped variable used inside a compound type (a pair).
let dup : {a} a -> (a, a) =
  \x ->
    let mk : a -> (a, a) = \y -> (y, y) in
    mk x

-- 05: the scoped variable annotating a pattern-bound variable in a match branch.
let firstOr : {a} a -> List a -> a =
  \fallback xs ->
    match xs with
    | [] -> fallback
    | h :: _ ->
      let picked : a = h in
      picked

-- 06: an inner *recursive* helper whose annotation mentions the outer `a`.
let reverse : {a} List a -> List a =
  \xs ->
    let go : List a -> List a -> List a =
      \acc ys ->
        match ys with
        | [] -> acc
        | h :: t -> go (h :: acc) t
    in
    go [] xs

-- 07: a mutually recursive top-level pair, each with its own signature. Each
-- body uses its own scoped `a`, in a parameter annotation and in an inner
-- `let` annotation respectively.
let evensF : {a} Int -> a -> List a =
  \n (x : a) -> if n < 1 then [] else x :: evensG (n - 1) x

let evensG : {a} Int -> a -> List a =
  \n x ->
    let rest : List a = evensF (n - 1) x in
    rest

-- 08: the scoped variable inside a user-defined data type, in an inner `let`.
let toList : {a} Maybe a -> List a =
  \m ->
    let empty : List a = [] in
    match m with
    | Nothing -> empty
    | Just x -> [x]

-- 09: an inner signature that quantifies its own `a` shadows the outer `a`.
let shadow : {a} a -> a =
  \x ->
    let id : {a} a -> a = \(z : a) -> z in
    id x

-- 10: the same scoping rule inside a nested `let ... in` expression rather
-- than a top-level binding.
let nestedBlock =
  let outer : {a b} a -> b -> (a, b) =
    \x y ->
      let p : (a, b) = (x, y) in
      p
  in outer 1 True

-- 11: an inner polymorphic binding whose type mixes its own `b` with the
-- outer, fixed `a`; then a use of it at a type mentioning the outer `a`.
let nested : {a} a -> a =
  \x ->
    let inner : {b} b -> (a, b) = \(y : b) -> (x, y) in
    let r : (a, Bool) = inner True in
    x


-- =========================================================================
-- Ordinary recursion (no signatures)
-- =========================================================================

-- 12: unannotated mutual recursion. Each member has one type inside the group
-- and is generalised only once the whole group has been inferred.
let ordinaryF =
  \n x -> if n < 1 then [x] else ordinaryG (n - 1) x

let ordinaryG =
  \n x -> x :: ordinaryF n x

-- 13: once its group has been inferred, an unannotated recursive definition is
-- generalised as usual, and later code may use it at different types.
let ordinaryId =
  \x -> if True then x else ordinaryId x

let ordinaryIdInt = ordinaryId 1
let ordinaryIdBool = ordinaryId True

-- 14: forward references inside one `let` block are fine when there is no
-- cycle: dependency analysis puts `y` before `x`.
let forwardReference =
  let
    x = y
    y = 1
  in x


-- =========================================================================
-- Polymorphic recursion (annotated definitions)
-- =========================================================================

-- 15: an annotated function calling itself at a different type: the recursive
-- call is at `List a`.
let wrapN : {a} Int -> a -> Int =
  \n x -> if n < 1 then 0 else 1 + wrapN (n - 1) [x]

-- 16: the classic use. Mapping over a nested datatype needs the recursive
-- call at `List a -> List b`, a different type from the outer `a -> b`.
let mapList : {a b} (a -> b) -> List a -> List b =
  \f xs ->
    match xs with
    | [] -> []
    | h :: t -> f h :: mapList f t

let mapNested : {a b} (a -> b) -> Nested a -> Nested b =
  \f t ->
    match t with
    | Flat x -> Flat (f x)
    | Nest inner -> Nest (mapNested (mapList f) inner)

-- 17: two annotated functions calling each other, each at a new type: `ping`
-- calls `pong` at `List a`, and `pong` calls `ping` at `(b, b)`.
let ping : {a} Int -> a -> Int =
  \n x -> if n < 1 then 0 else 1 + pong (n - 1) [x]

let pong : {b} Int -> b -> Int =
  \n y -> if n < 1 then 0 else 1 + ping (n - 1) (y, y)

-- 18: polymorphic recursion inside a scoped body. The inner `go` is used at a
-- different `a` on every call, while the outer `c` stays the same throughout:
-- it is the type of this particular call to `keepOuter`.
let keepOuter : {c} c -> c =
  \w ->
    let go : {a} Int -> a -> c =
      \n x -> if n < 1 then w else go (n - 1) [x]
    in
    go 3 True


-- =========================================================================
-- Signatures as dependency cuts
-- =========================================================================
--
-- In these examples the definitions form one recursive group, but a signature
-- lets the unannotated members be inferred (and generalised) before the
-- annotated body is checked. Dead `if True then ... else` branches create the
-- dependencies without making evaluation loop.

-- 19: adding a correct signature to a working program must not break it.
-- Without the signature, `contractF` and `contractG` are ordinary recursion;
-- with it, the fixed `a` of `contractF`'s body flows through unannotated
-- `contractG`, which must still work.
let contractF : {a} a -> a =
  \x -> if True then x else contractG x

let contractG =
  \x -> contractF x

-- 20: an annotated body may use an unannotated member of its own group at two
-- types. `contractHelper` is inferred and generalised before
-- `contractConsumer`'s body is checked.
let contractConsumer : Int -> (Int, Bool) =
  \n -> (contractHelper n, contractHelper True)

let contractHelper =
  \x -> if True then x else let ignored = contractConsumer 0 in x

-- 21: the other direction. While `useF` is inferred, `f`'s type is already
-- known from its signature, so `f 1 : Int` and `f True : Bool` are both fine.
let f : {a} a -> a =
  \x -> if True then x else let ignored = useF 0 in x

let useF =
  \ignored -> (f 1, f True)

-- 22: the two uses may also be spread across different unannotated members,
-- all in one group with the annotated `distributedF`.
let distributedF : {a} a -> a =
  \x ->
    if True then x
    else let i = distributedInt 0 in let b = distributedBool 0 in x

let distributedInt =
  \n -> if True then distributedF 1 else n

let distributedBool =
  \n -> if True then distributedF True else True

-- 23: the signature splits the rest of the group. `f_`, `g_` and `h_` form one
-- cycle, but `h_` only reaches it through the annotated `f_`. Ignoring
-- references to `f_`, `h_` does not depend on `g_`, so `h_` is inferred and
-- generalised first, and `g_` may then use it at Int and at Bool. `f_`'s body
-- is checked last. (GHC accepts this too; OCaml, F# and Elm don't.)
let f_ : {a} a -> a =
  \x -> if True then x else let ignored = g_ 0 in x

let g_ =
  \ignored -> (h_ 1, h_ True)

let h_ =
  \x -> if True then x else let ignored = f_ 0 in x

-- 24: the same split inside a nested `let` block, within an annotated body
-- whose scoped `c` the inner signature mentions.
let cutInBlock : {c} c -> (c, (Int, Bool)) =
  \w ->
    let
      cf : {a} a -> c = \x -> if True then w else let i = cg 0 in w
      cg = \n -> (ch 1, ch True)
      ch = \x -> if True then x else let i = cf 0 in x
    in (cf True, cg 0)


-- =========================================================================
-- Results
-- =========================================================================
--
-- Uses at several types check that definitions really are generalised after
-- their group; evaluating the recursive examples checks that signatures don't
-- change how programs run.

let scopedResults =
  ((idParam 1, idParam True),
   (idLet True,
    (constHelper 1 True,
     (dup 1,
      (firstOr 0 [1, 2],
       ((reverse [1, 2, 3], reverse [True, False]),
        (evensF 3 True,
         (toList (Just 3),
          (shadow 1, (nestedBlock, nested 1))))))))))

let ordinaryResults =
  (ordinaryF 2 5, (ordinaryIdInt, (ordinaryIdBool, forwardReference)))

let polymorphicRecursionResults =
  (wrapN 3 True,
   (mapNested (\n -> n < 2) (Nest (Flat [1, 2, 3])),
    (ping 4 True, (keepOuter 1, keepOuter True))))

let dependencyCutResults =
  ((contractF 1, contractG True),
   (contractConsumer 1,
    (useF 0,
     ((distributedInt 0, distributedBool 0),
      (g_ 0, (cutInBlock 5, cutInBlock False))))))

(scopedResults,
 (ordinaryResults,
  (polymorphicRecursionResults, dependencyCutResults)))


-- =========================================================================
-- Rejected programs
-- =========================================================================
--
-- Each program below must be rejected with a type or scope error, not a parse
-- error. Paste one into its own file to check it.
--
-- F1: a scoped `a` is fixed; it cannot be specialised to Int.
--   let bad1 : {a} a -> a =
--     \x -> let y : a = 5 in y
--   bad1 1
--
-- F2: `b` and `a` are distinct fixed types.
--   let bad2 : {a b} a -> b -> a =
--     \x y -> let f : b -> a = \z -> z in f y
--   bad2 1 True
--
-- F3: a lambda parameter annotated with the scoped `a` cannot be used at Int.
--   let bad3 : {a} a -> a =
--     \(x : a) -> x + 1
--   bad3 1
--
-- F4: a type variable that no enclosing signature binds is a scope error.
--   let bad4 : {a} a -> a =
--     \x -> let y : c = x in y
--   bad4 1
--
-- F5: without a signature, a function cannot call itself at a different type.
-- (Inferring polymorphic recursion is undecidable in general.)
--   let bad5 =
--     \x -> if True then x else bad5 [x]
--   bad5 1
--
-- F6: example 21 without the signature. Both members are unannotated and depend
-- on each other, so `bad6F` has one type inside the group, and its Int and
-- Bool uses conflict.
--   let bad6F =
--     \x -> if True then x else let ignored = bad6UseF 0 in x
--
--   let bad6UseF =
--     \ignored -> (bad6F 1, bad6F True)
--
--   bad6UseF 0
--
-- F7: example 23 without the signature. With nothing to split at, all three
-- are one group, so `bad7H` has one type throughout and cannot be used at
-- both Int and Bool.
--   let bad7F =
--     \x -> if True then x else let ignored = bad7G 0 in x
--   let bad7G =
--     \ignored -> (bad7H 1, bad7H True)
--   let bad7H =
--     \x -> if True then x else let ignored = bad7F 0 in x
--   bad7G 0
--
-- F8: example 23, but `bad8G` and `bad8H` still call each other directly.
-- Ignoring references to the annotated `bad8F` leaves them in one group, so
-- `bad8H` has one type inside it.
--   let bad8F : {a} a -> a =
--     \x -> if True then x else let i = bad8G 0 in x
--   let bad8G =
--     \n -> if True then (bad8H 1, bad8H True) else let j = bad8H 0 in (bad8H 1, bad8H True)
--   let bad8H =
--     \x -> if True then x else let i = bad8G 0 in let j = bad8F 0 in x
--   bad8G 0
--
-- F9: example 23, but `bad9F`'s body breaks its own signature (it returns an
-- Int, not an `a`). Annotated bodies are still checked, just last.
--   let bad9F : {a} a -> a =
--     \x -> if True then 3 else let i = bad9G 0 in x
--   let bad9G =
--     \n -> (bad9H 1, bad9H True)
--   let bad9H =
--     \x -> if True then x else let i = bad9F 0 in x
--   bad9G 0
