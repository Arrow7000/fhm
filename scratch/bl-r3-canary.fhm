-- R3 canary — multi-model vs unconstrained free vs unique interval type.
-- Run: .lake/build/bin/fhm run --bl scratch/bl-r3-canary.fhm
-- Fail mid-case: .lake/build/bin/fhm run --bl scratch/bl-r3-mid-fail.fhm
--
-- Policy (memo §5 F): uniqueness is elaborator policy (uniqueOnly at escape).
--
--   Vacuous free     residual empty → generalise ∀                              OK
--   Unique ground    residual sat + unique outs → commit σ                     OK
--   Mid-case multi   residual sat, |models| > 1 → reject + ask let-ascription  FAIL
--
-- NOT mid-case: join → unique *range type* BL 1 3 (endpoints determined).
--
-- Residual factory: Synth app meet (`meetForApp`) accumulates Exists Sub goals
-- when demand is DemandOK but not exact-pin (e.g. affine BL x (2*x)). Check pack
-- passes them to `packAtEscape`. Empty residual ⇒ still vacuous generalise.
--
-- Canonical mid-case (memo §5 F example 1) lives in bl-r3-mid-fail.fhm:
--   f : {x} BL x (2*x) Int → BL x (2*x) Int
--   e : BL 10 10 Int
--   f e  ⇒  5 ≤ ?x ≤ 10 on free result  ⇒  uniqueOnly reject

-- (1) Vacuous free → generalise (must stay OK)
let listId : BL _ _ Int -> BL _ _ Int =
  \xs -> xs

-- (2) Join → unique range type BL 1 3 (not multi-model commit)
let eitherLen =
  \b ->
    if b then
      [1]
    else
      [1, 2, 3]

(listId [1, 2], (eitherLen True, eitherLen False))
