-- Positive contract-stratified mixed group (genuinely mutual: f refs g,
-- g refs f). f is annotated polymorphic {a} Int -> a -> Int; g is
-- unannotated. While g is inferred, f's complete contract is available, so
-- g's body may call f at TWO instantiations:
--   `f n m`   a := β (m : β, the pool var)
--   `f n [m]` a := List β
-- g is then generalized. f's RHS is checked afterwards, with g's final scheme
-- available. Thus both directions remain polymorphic without inferring
-- polymorphic recursion for an unsigned member.

let f : {a} Int -> a -> Int =
  \n x -> if n < 1 then 1 else let u = g (n - 1) in 1

let g =
  \n m -> f n m + f n [m]

(f 2 5, g 3 True)
