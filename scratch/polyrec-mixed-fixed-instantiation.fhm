-- Positive contract-stratified mixed group. The complete signature for `f` is
-- assumed while unannotated `g` is inferred and generalized. Then `f`'s RHS is
-- checked with that final scheme for `g` in scope. Passing `f`'s rigid argument
-- through `g` is therefore ordinary instantiation, not skolem escape.

let f : {a} Int -> a -> List a =
  \n x -> if n < 1 then Cons x Nil else g (n - 1) x

let g =
  \n x -> Cons x (f n x)

f 2 5
