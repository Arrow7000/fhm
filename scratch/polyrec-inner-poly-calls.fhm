-- Positive annotated in-block polymorphism. f and g are mutually recursive
-- (one SCC group), but f's complete contract is a dependency cut. While
-- unannotated g is inferred, its body calls f at TWO DIFFERENT instantiations:
--   `f n m`   instantiates {a} Int -> a -> Int at a := Int
--   `f n [m]` instantiates the same scheme at a := List Int
-- g is inferred as `Int -> Int` and generalized; f's RHS is checked afterwards
-- with that final scheme in scope.

let f : {a} Int -> a -> Int =
  \n x -> if n < 1 then 1 else g (n - 1)

let g =
  \n -> f n n + f n [n]

-- f 2 5 = g 1 = f 1 1 + f 1 [1] = (g 0 + g 0) + (g 0 + g 0) = 2+2+2+2 = 8? No:
--   g 0 = f 0 0 + f 0 [0] = (n < 1) 1 + 1 = 2; f 1 x = g 0 = 2; g 1 = 2 + 2 = 4;
--   f 2 x = g 1 = 4.
-- f 2 [True] = g 1 = 4 likewise, at a := List Bool.
(f 2 5, f 2 [True])
