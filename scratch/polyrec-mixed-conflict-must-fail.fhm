-- Must FAIL: complete `f` is a dependency cut, but unannotated `h` still uses
-- itself polymorphically while the unsigned sub-group is inferred. In `h`'s
-- RHS, `f y : List a`, so the self-call requires the same monomorphic `h` at
-- both `a` and `List a`. This forces `a ~ List a` and fails the occurs check.

let f : {a} a -> List a =
  \x -> h x

let h =
  \y -> h (f y)

f 1
