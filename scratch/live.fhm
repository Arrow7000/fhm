-- Custom ADTs in the spotlight — less “lists of ints”, more trees & colours.
-- Head-binder mix: pure λs, full head binders, and hybrid (some head, rest λ).

type Maybe a =
  | Just a
  | Nothing

type Tree a =
  | Leaf
  | Node a (left : Tree a) (right : Tree a)




type Color = Red | Green | Blue

-- Full head binders (incl. type params + return-type sugar on the last args)
let map {a b} (f : a -> b) (xs : List a) : List b =
  match xs with
  | [] -> []
  | h :: t -> (f h) :: (map f t)

-- Hybrid: head tyParam {a} + residual scheme quantifier {b} on the colon
-- (b unused in the body — fine; quantifiers don't need to occur)
let filter {a} (p : a -> Bool) : {b} List a -> List a =
  \xs ->
    match xs with
    | [] -> []
    | h :: t ->
      if p h then
        h :: (filter p t)
      else
        filter p t

-- Pure value λs (classic style)
let mapMaybe : {a b} (a -> b) -> Maybe a -> Maybe b =
  \f m ->
    match m with
    | Nothing -> Nothing
    | Just x -> Just (f x)

-- Hybrid: f as head binder, tree as λ
let treeMap {a b} (f : a -> b) : Tree a -> Tree b =
  \t ->
    match t with
    | Leaf -> Leaf
    | Node x l r -> Node (f x) (treeMap f l) (treeMap f r)

-- Full head binder + annotated param
let colorOf (n : Int) : Color =
  if n < 2 then
    Red
  else if n < 5 then
    Green
  else
    Blue

-- Pure λ
let warm = \c ->
  match c with
  | Red -> True
  | Green -> False
  | Blue -> False

let t = Node 1 Leaf (Node 4 Leaf (Node 9 Leaf Leaf))

let xs = [0, 1, 4, 9, 2]



-- Full head binders + return-type sugar (need `: ret` so `{a}` finalizes into the
-- prenex scheme; bare `let listLength {a} (l : List a) =` cannot lower — `a` in
-- the param type has no scheme to bind it yet)
let listLength {a} (l : List a) : Int =
  match l with
  | [] -> 0
  | head :: tail -> 1 + listLength tail


-- Hybrid: first arg head, second still λ
let addInts (a : Int) : Int -> Int =
  \b -> a + b

-- Tree Color, Maybe Color, List Color, List Bool
-- (treeMap colorOf t,
--   (mapMaybe colorOf (Just 4),
--     (map colorOf xs, map warm (map colorOf (filter (\n -> n < 5) xs)))))

addInts (listLength xs) 12
