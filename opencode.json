{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "lean-lsp": {
      "type": "local",
      "enabled": true,
      "timeout": 600000,
      "command": [
        "/Users/aron/dev/lean-lsp-mcp/scripts/ensure-fhm-mcp.sh"
      ]
    }
  },
  "agent": {
    "glm-worker": {
      "description": "Proof-workhorse worker for the fhm Lean project (GLM 5.3 Flash via OpenRouter)",
      "model": "openrouter/z-ai/glm-5.3-flash",
      "mode": "primary",
      "temperature": 0.1,
      "permission": {
        "edit": "allow",
        "bash": {
          "lake env lean *": "allow",
          "grep*": "allow",
          "sed -n*": "allow",
          "cat*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git status*": "allow"
        }
      }
    },
    "gemini-worker": {
      "description": "Proof-workhorse worker for the fhm Lean project (Gemini 3.6 Flash via Google api credential; fallback while DeepSeek/Z.AI are out of quota)",
      "model": "google/gemini-3.6-flash",
      "mode": "primary",
      "temperature": 0.1,
      "permission": {
        "edit": "allow",
        "bash": {
          "lake env lean *": "allow",
          "grep*": "allow",
          "sed -n*": "allow",
          "cat*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git status*": "allow"
        }
      }
    }
  }
}